# --- restoAdmin connection (server/ backend only — never exposed to the browser) ---

# Base URL of restoAdmin's Node API (its server/, not its Vite frontend).
# Both the REST calls and the live Socket.IO link use it.
#   Local:      http://localhost:2000  (restoAdmin's `npm run dev:server`)
#   Production: the hosted API's public URL, e.g. https://api.example.com —
#               ask whoever runs restoAdmin's server. Pointing here means
#               every order the dashboard makes is real.
ADMIN_API_BASE_URL="http://localhost:2000"

# Only if restoAdmin is served under a path prefix by a reverse proxy (e.g.
# https://example.com/resto/...): put the prefix in ADMIN_API_BASE_URL above
# AND set the matching Socket.IO path here. Leave unset otherwise.
# ADMIN_SOCKET_PATH="/resto/socket.io"

# Credentials for a dedicated, non-admin restoAdmin user scoped to the Blue
# Moon branch, created via restoAdmin's Employees/User Management on the
# server ADMIN_API_BASE_URL points at. Used only by this backend to
# authenticate server-to-server — never sent to the browser. restoAdmin
# allows one active session per account, so nobody else may sign in with it.
# See docs/blue-moon-integration.md#setting-up-the-sync-account.
ADMIN_USERNAME="restodashboard-sync"
ADMIN_PASSWORD="change-me"

# restoAdmin's Blue Moon branch id (restoAdmin's src/utils/floorScope.ts).
ADMIN_BRANCH_ID=3

# Port this backend listens on (the Vite dev server proxies /api to it).
PORT=3510
