# --- restoAdmin connection (server/ backend only — never exposed to the browser) ---

# Base URL of restoAdmin's Node API (its server/, not its Vite frontend).
# Both the REST calls and the live Socket.IO link use it.
#   Local:      http://localhost:2000  (restoAdmin's `npm run dev:server`)
#   Live:       https://moonctgroup.com/data-api  (the Node API sits behind
#               the /data-api prefix there; https only — plain http serves
#               nginx's default page). Pointing here means every order the
#               dashboard makes is real.
ADMIN_API_BASE_URL="http://localhost:2000"

# Socket.IO path on ADMIN_API_BASE_URL's host (any path in that URL is ignored
# for the socket). Defaults to /socket.io, which is right for both local and
# moonctgroup.com. Only set it if a proxy serves Socket.IO under a prefix.
# ADMIN_SOCKET_PATH="/resto/socket.io"

# No restoAdmin account goes here: staff sign in on the dashboard's login
# page with their own restoAdmin account (see docs/blue-moon-integration.md#signing-in).

# restoAdmin's Blue Moon branch id (restoAdmin's src/utils/floorScope.ts).
# Only users in this branch (with restoAdmin role id 3) can sign in.
ADMIN_BRANCH_ID=3

# Port this backend listens on (the Vite dev server proxies /api to it).
PORT=3510
